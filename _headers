# En-tetes servis par Cloudflare (Workers Assets lit ce fichier comme Pages).
# A deposer a la RACINE du dossier servi, a cote de index.html.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Le logo sert aussi d'og:image : les robots de Discord et consorts le
# rechargent souvent, autant qu'il soit mis en cache longuement.
/vault-logo.png
  Cache-Control: public, max-age=604800, immutable
